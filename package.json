{
  "name": "agent-order-network",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Developer preview: Skill-first peer-to-peer on-chain orders for existing agents",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "tools": "node scripts/agent-tools.mjs",
    "package:skill": "npm run compile && node scripts/package-skill.mjs",
    "demo:skill": "npm run compile && node scripts/demo-skill.mjs",
    "compile": "node scripts/compile.mjs",
    "test": "npm run compile && node --test --test-concurrency=1 test/*.test.mjs",
    "local:network": "npm run compile && node scripts/start-local.mjs",
    "preview:verify": "npm test && node scripts/demo-skill.mjs && node scripts/package-skill.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "hardhat": "3.20.0",
    "solc": "0.8.37"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
